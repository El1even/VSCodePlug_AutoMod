{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AutoMod",
  "scopeName": "source.automod",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#blocks"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.automod",
          "match": "/\\*[\\s\\S]*?\\*/"
        },
        {
          "name": "invalid.illegal.unterminated-comment.automod",
          "match": "/\\*[\\s\\S]*"
        },
        {
          "name": "comment.line.automod",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.automod",
          "match": "\"(?:\\\\.|[^\"\\\\\\n])*\""
        },
        {
          "name": "string.quoted.single.automod",
          "match": "'(?:\\\\.|[^'\\\\\\n])*'"
        },
        {
          "name": "invalid.illegal.unterminated-string.automod",
          "match": "\"(?:\\\\.|[^\"\\\\\\n])*$"
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "match": "(?i:\\bbegin)\\s+(power\\s+and\\s+free|bridge\\s+crane|path\\s+mover|kinematics|resources|variables|conveyor|downtime|schedule|process|general|queues|as/rs|loads|shift|agv)\\s+(?:system\\s+)?([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "0": {
              "name": "keyword.control.automod"
            },
            "1": {
              "name": "keyword.other.system-type.automod"
            },
            "2": {
              "name": "entity.name.type.automod"
            }
          }
        },
        {
          "match": "(?i:\\bbegin)\\s+(model|procedure)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "0": {
              "name": "keyword.control.automod"
            },
            "1": {
              "name": "keyword.other.automod"
            },
            "2": {
              "name": "entity.name.function.automod"
            }
          }
        },
        {
          "match": "(?i:\\bbegin)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "0": {
              "name": "keyword.control.automod"
            },
            "1": {
              "name": "entity.name.function.automod"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*(?i:\\b(integer|real|string|boolean|process|queue|load|resource|variable|attribute|entity|table))\\s+((?!(?i:to|of|for|by|via|type|then|do|else|end|begin|and|or|not)\\b)[A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "storage.type.automod"
            },
            "2": {
              "name": "variable.other.declaration.automod"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.automod",
          "match": "(?<![A-Za-z0-9_$])\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.automod",
          "match": "(?i)\\b(begin|end|model|initialization|function|procedure|subroutine|arriving|departing|leaving|add|bring|up|take|down|break|call|cancel|choose|claim|clone|close|configure|continue|create|decrement|delete|dispatch|display|do|until|free|get|increment|insert|move|into|onto|to|from|on|via|open|order|plot|preempt|print|read|release|remove|reserve|return|rotate|scale|schedule|send|set|tabulate|terminate|translate|travel|undisplay|use|wait|while|for|each|in|by|is|this|die|if|then|else|and|or|not|true|false|of|type|nlt|writing|save|result|as|be|ordered)\\b"
        },
        {
          "name": "keyword.operator.word.automod",
          "match": "(?i)\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.automod",
          "match": "(?i)\\b(true|false)\\b"
        },
        {
          "name": "keyword.other.end.automod",
          "match": "(?i)\\b(endif|endwhile|endfor|endloop|endbegin)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.automod",
          "match": "(?i)\\b(abs|acos|asin|atan|ceil|cos|exp|fabs|floor|log|log10|pow|sin|sqrt|tan|round|trunc|min|max|mod|uniform|normal|exponential|gamma|lognormal|triangular|weibull|constant|oneof|nextof|random|time|clock|dist|str|num)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.automod",
          "match": "<>|!=|<=|>=|==|=|\\+|-|\\*|/|%|\\^|<|>|&|\\||~"
        }
      ]
    }
  }
}
